+++ b/tests/test_station_io.py
@@ -11,6 +11,7 @@ import time
 
 import pytest
 
+from dssq.ccsds.tm import FHP_ONLY_IDLE_DATA, build_frame, encode_cadu
 from dssq.config import load_config
 from dssq.display import frontpanel as fp
 from dssq.gds import GroundStation
@@ -144,3 +145,49 @@ def test_panel_status_matrix_fields_without_reception(tmp_path, monkeypatch):
     assert m == {"sync": "SEARCH", "tx": False, "rssi_dbm": None, "rssi_recent": False, "rssi_overload": None,
                  "margin_db": None, "margin_floor": None, "lost_10m": 0, "clock_synced": None}
     assert fp.matrix_line(gs.panel_status()) == "M|S|0|-|?|0|?"
+
+
+def test_matrix_frame_sync_row_goes_dark_at_los(tmp_path, monkeypatch):
+    """The frame synchronizer changes state only on received octets, so after a pass it keeps
+    its last LOCK; the M line sends SEARCH once no radio unit came within the LOS timeout."""
+    t0 = 1_800_000_000.0
+    now = [t0 + 3]
+    monkeypatch.setattr(time, "time", lambda: now[0])
+    gs = _gs(tmp_path, monkeypatch, rcu=False)
+    for i in range(3):                                     # [CADU][RSSI octet 156 = -100 dBm]
+        gs.ingest(encode_cadu(build_frame(0, i, i, FHP_ONLY_IDLE_DATA, bytes(188), 0)) + bytes([156]), t0 + i)
+    gs.housekeeping(now[0])
+    assert gs.sync.state == "LOCK" and gs.panel_status()["matrix"]["sync"] == "LOCK"
+    assert fp.matrix_line(gs.panel_status()).startswith("M|L|")
+    los = gs.rx.los_timeout_s                              # set by housekeeping()
+    assert los is not None
+    now[0] = t0 + 2 + los + 1                              # past the LOS timeout, nothing received
+    gs.ingest(b"", now[0])
+    gs.housekeeping(now[0])
+    assert gs.rx.los and gs.sync.state == "LOCK"            # the synchronizer itself is unchanged
+    m = gs.panel_status()["matrix"]
+    assert (m["sync"], m["rssi_recent"]) == ("SEARCH", False)
+    assert fp.matrix_line(gs.panel_status()).startswith("M|S|0|-|")
+
+
+
+def test_rcu_configured_but_not_available_is_not_called_rcu_false(tmp_path, monkeypatch):
+    """D-78: with [gds] rcu = true and no RCU in use, radio.rcu_unavailable and the register
+    check give the reason - no radio backend (serial port) or no Router Bridge - instead of
+    sending the operator to a station.toml that already says true."""
+    gs = _gs(tmp_path, monkeypatch, rcu=True)
+    gs.attach_radio(None, None, "E22-400T33D serial port: [Errno 2] No such file or directory")
+    r = gs.snapshot()["radio"]
+    assert r["rcu"] is False and gs.snapshot()["station_io"]["rcu_configured"] is True
+    assert r["rcu_unavailable"] == "no radio backend (E22-400T33D serial port: [Errno 2] No such file or directory)"
+    assert r["register_check"] == ("not read back: Radio Control Unit not available ([gds] rcu = true: no radio "
+                                   "backend (E22-400T33D serial port: [Errno 2] No such file or directory)) - RSSI "
+                                   "byte and noise enable assumed from station.toml")
+    gs.attach_radio(object(), None)                          # port open, no Router Bridge: no RCU built
+    r = gs.snapshot()["radio"]
+    assert r["rcu_unavailable"] == "no Router Bridge to the station MCU" and "rcu = false" not in r["register_check"]
+    off = _gs(tmp_path / "off", monkeypatch, rcu=False)
+    off.attach_radio(object(), None)
+    r = off.snapshot()["radio"]
+    assert r["rcu_unavailable"] is None
+    assert r["register_check"].startswith("not read back: no Radio Control Unit ([gds] rcu = false) - ")
