+def _sim_run(sim, clock, seconds: float, step: float = 0.25) -> list[dict]:
+    """The simulator's own scheduler for `seconds`; the ATT values it generated."""
+    got: list[dict] = []
+    sim._emit_values = lambda apid, v, vc, now: got.append(dict(v)) if apid == dd.APID_ATT else None
+    end = clock[0] + seconds
+    while clock[0] < end:
+        sim._run_spacecraft(clock[0])
+        clock[0] += step
+    return got
+
+
+def test_simulated_att_windows_start_when_att_is_enabled():
+    """D-75: no window is kept while ATT is off (SAFE): the first ATT after MODE TEST covers only the
+    windows since ATT generation was enabled, not the SAFE period (at most one window here)."""
+    from dssq.config import load_config
+    from dssq.sim import SimSpacecraft
+
+    clock = [1_800_000_000.0]
+    sim = SimSpacecraft(load_config(), clock=lambda: clock[0], seed=3)
+    assert _sim_run(sim, clock, 600.0) == []                             # SAFE: ATT off
+    sim._effect(0x02, bytes([4]), clock[0])                              # MODE TEST
+    atts = _sim_run(sim, clock, 20.0)
+    assert len(atts) == 3 and atts[0]["imu_nwin"] <= 1 and [a["imu_nwin"] for a in atts[1:]] == [8, 8]
+    assert all(bool(a["imu_flags"] & 0x02) == (a["imu_nwin"] >= 1) for a in atts)
+
+
+def test_simulated_att_period_over_255_s_saturates_the_count_only():
+    """imu_nwin saturates at 255 as the flight's counter does; the statistics cover every window
+    (PKTRATE ATT 600: 600 windows)."""
+    from dssq.config import load_config
+    from dssq.sim import ATT_IDX, SimSpacecraft, _body_rates
+
+    clock = [1_800_000_000.0]
+    sim = SimSpacecraft(load_config(), clock=lambda: clock[0], seed=3)
+    sim._effect(0x02, bytes([4]), clock[0])                              # MODE TEST
+    sim.period_override[ATT_IDX] = 600                                   # PKTRATE ATT 600
+    atts = _sim_run(sim, clock, 601.0, step=1.0)
+    assert len(atts) == 2 and atts[1]["imu_nwin"] == 255
+    end = int(clock[0] - 1.0 - sim.t0)
+
+    def mean(first: int) -> list[float]:
+        return [sum(math.degrees(_body_rates(k + (i + 0.5) / 25)[a]) for k in range(first, end) for i in range(25))
+                / (25 * (end - first)) for a in range(3)]
+
+    got = [atts[1][f"rate_mean_{a}"] for a in "xyz"]
+    assert got == pytest.approx(mean(end - 600), abs=0.02)
+    assert max(abs(g - m) for g, m in zip(got, mean(end - 255), strict=True)) > 0.1    # not the newest 255 only
+
