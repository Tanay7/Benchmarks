+// D-75 pairing of page 2 with page 0 (Flight::start_mag_sample). `motion` holds the page 0
+// just read (any type with a uint8_t `seq`, the ARU rebuild counter); read_imu(AruImu&) reads
+// page 2 right after it. When page 2 comes from a later rebuild, read_motion(Motion&) reads
+// page 0 once more - it then normally comes from page 2's rebuild - and replaces `motion`
+// only when that read succeeds. `paired` = both pages from one rebuild (equal seq), whatever
+// their content: it does not depend on the 9-DOF quaternion or any other validity flag.
+struct AruPairing {
+  bool imu_ok = false;     // page 2 read and decoded (`imu` set)
+  bool paired = false;     // imu_ok and imu.seq == motion.seq
+};
+template <class Motion, class ReadMotion, class ReadImu>
+AruPairing aru_read_paired(Motion& motion, AruImu& imu, ReadMotion read_motion, ReadImu read_imu) {
+  AruPairing p;
+  p.imu_ok = read_imu(imu);
+  if (p.imu_ok && imu.seq != motion.seq) {
+    Motion again = motion;
+    if (read_motion(again)) motion = again;
+  }
+  p.paired = p.imu_ok && imu.seq == motion.seq;
+  return p;
+}
