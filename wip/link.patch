+class _SurveyRm:
+    """A RadioManager stand-in whose survey reads the given raw noise values (dBm, as
+    RadioManager.survey returns them: E22 -(256 - octet), uncalibrated)."""
+
+    def __init__(self, raw, packet=False):
+        self.raw, self.packet, self.survey_refused, self.last_scan = raw, packet, None, None
+
+    def survey(self, first, last, home=None):
+        noise = list(self.raw)
+        valid = [(n, first + i) for i, n in enumerate(noise) if n is not None]
+        self.last_scan = {"t": T0, "first": first, "noise": noise, "quietest": min(valid)[1] if valid else None,
+                          "duration_s": 0.9, "home": home, "home_restored": True}
+        return self.last_scan
+
