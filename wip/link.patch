+def test_ground_survey_rejects_end_of_range_noise_octets(tmp_path):
+    """LS-5 (D-76): an E22 noise octet 0x00 (-256 dBm) or 0xFF (-1 dBm) is no noise power, as
+    in rxstats.on_noise_octet: the GSCAN keeps it out of the bars and of the quietest channel
+    (it ranked the busiest channel first) and names it; the SX126x has no such octet."""
+    gs = _gs(tmp_path, rssi_cal_offset_db=-2.0)                                    # allowed CH20-24
+    rm = _SurveyRm([-96.0, -256.0, -100.0, -1.0, -98.0, -170.0])                   # CH20..CH25
+    gs._run_job(rm, "GSCAN", (20, 25))
+    scan = rm.last_scan
+    assert scan["noise"] == [-98.0, None, -102.0, None, -100.0, None]
+    assert scan["rejected"] == {"21": "OVERLOAD", "23": "OVERLOAD", "25": "INVALID"}
+    assert (scan["quietest"], scan["quietest_allowed"]) == (22, 22)
+    ev = [e["text"] for e in gs.events if e["text"].startswith("ground RF survey")][-1]
+    assert "quietest CH22, quietest allowed CH22, CH21 OVERLOAD (no noise power)" in ev
+    sx = _SurveyRm([-117.5, -1.0, -256.0], packet=True)                            # SX126x: readings, not octets
+    gs._run_job(sx, "GSCAN", (20, 22))
+    assert sx.last_scan["rejected"] == {"22": "INVALID"} and sx.last_scan["noise"] == [-119.5, -3.0, None]
+    assert sx.last_scan["quietest"] == 20
