+def test_link_manager_noise_floor_bound_is_no_p10_margin_on_metrics(tmp_path):
+    """LS-6 (D-76): at the noise floor the link manager's p10 margin is only the upper bound
+    noise - S: /metrics exports it as dssq_linkmgr_margin_p10_max_db, never as the p10 margin;
+    LINKMGR OFF clears the recommendation, so no stale gauge stays exported."""
+    def metrics(rec):
+        return web.prometheus({"linkmgr": {"recommendation": rec}})
+    text = metrics({"margin_p10_db": 7.8, "noise_state": "NOISE_FLOOR"})
+    assert "dssq_linkmgr_margin_p10_db" not in text and "\ndssq_linkmgr_margin_p10_max_db 7.8\n" in text
+    for state in ("SIGNAL", "NEAR_NOISE", "NOISE_UNKNOWN"):
+        text = metrics({"margin_p10_db": 12.0, "noise_state": state})
+        assert "\ndssq_linkmgr_margin_p10_db 12.0\n" in text and "dssq_linkmgr_margin_p10_max_db" not in text
+    gs = _gs(tmp_path)
+    gs.link_mgr.recommendation = {"action": "NONE", "margin_p10_db": 7.8, "noise_state": "NOISE_FLOOR"}
+    assert gs.submit_command("LINKMGR ADVISE")["status"] == "OK" and gs.link_mgr.recommendation is not None
+    assert gs.submit_command("LINKMGR OFF")["status"] == "OK"
+    s = json_safe(gs.snapshot())
+    assert s["linkmgr"]["mode"] == "OFF" and s["linkmgr"]["recommendation"] is None
+    assert "dssq_linkmgr_margin_p10" not in web.prometheus(s)
