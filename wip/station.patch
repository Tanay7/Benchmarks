+    line("S|1|2|0|0");
+    line(kM);
+    (void)step_loop(kMxTickMs);
+    const auto v = step_loop(3000, "S|1|2|0|0", kM);
+    int odd = 0, odd_len = 0, odd_val = -1, after = 0;
+    for (auto& x : runs(cols(v, 7))) {
+      if (odd) after += x.second == static_cast<int>(kAlarmRedHalfMs);
+      if (x.second != static_cast<int>(kAlarmRedHalfMs)) {
+        ++odd;
+        odd_len = x.second;
+        odd_val = x.first;
+      }
+    }
+    bool up = true;                                          // AOS and LOCK lit: link and M data current
+    for (auto& f : v) up = up && lit(f.data(), 0) == kMxCols && lit(f.data(), 1) == kMxCols;
+    CHECK(odd == 1 && odd_val == 0 && odd_len == static_cast<int>(kAlarmRedHalfMs + 4294967296ull % kAlarmRedHalfMs) &&
+              after >= 8 && up,
+          "matrix across the 2^32 millis() wrap: RED keeps blinking (one dark half-period 46 ms longer), link up");
+  }
   printf("%s [E22]: %d failure(s)\n", SKETCH, g_failures);
   return g_failures ? 1 : 0;
 }
