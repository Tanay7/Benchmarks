+// Manual clock (runtime.h): `ms` loop passes, one per millisecond, with the GDS's S line `s`
+// and M line `m` once a second as display/frontpanel.py sends them (s = nullptr: none, the
+// GDS silent). Returns the frame last drawn after every pass.
+using Frame = std::array<uint8_t, kMxCols * kMxRows>;
+static std::vector<Frame> step_loop(uint32_t ms, const char* s = nullptr, const char* m = nullptr) {
+  std::vector<Frame> v;
+  for (uint32_t i = 0; i < ms; ++i) {
+    if (s && i % 1000 == 0) {
+      line(s);
+      if (m) line(m);
+    }
+    ++g_clock_ms;
+    loop();
+    Frame f;
+    memcpy(f.data(), g_matrix_rec.frame, f.size());
+    v.push_back(f);
+  }
+  return v;
+}
+// Row `row` of every frame: columns lit.
+static std::vector<int> cols(const std::vector<Frame>& v, int row) {
+  std::vector<int> c;
+  for (auto& f : v) c.push_back(lit(f.data(), row));
+  return c;
+}
+// (value, length in ms) of the runs of equal values, without the first and the last run
+// (cut by the window).
+static std::vector<std::pair<int, int>> runs(const std::vector<int>& v) {
+  std::vector<std::pair<int, int>> r;
+  size_t start = 0;
+  for (size_t i = 1; i <= v.size(); ++i) {
+    if (i == v.size() || v[i] != v[i - 1]) {
+      r.push_back({v[start], static_cast<int>(i - start)});
+      start = i;
+    }
+  }
+  if (r.size() <= 2) return {};
+  return std::vector<std::pair<int, int>>(r.begin() + 1, r.end() - 1);
+}
+// At least n complete runs, alternating between 0 and all 13 columns, each half_ms long.
+static bool blinks(const std::vector<int>& v, size_t n, int half_ms) {
+  const auto r = runs(v);
+  bool ok = r.size() >= n;
+  for (auto& x : r) ok = ok && (x.first == 0 || x.first == kMxCols) && x.second == half_ms;
+  return ok;
+}
