diff --git a/tests/test_link_legitimacy.py b/tests/test_link_legitimacy.py
index e50e578..88499a1 100644
--- a/tests/test_link_legitimacy.py
+++ b/tests/test_link_legitimacy.py
@@ -173,6 +173,30 @@ def test_noise_pairs_only_within_the_pass():
     assert r.w["10m"]["snr_est"].stats(T0 + 3601)["n"] == 0             # window: the paired one aged out
 
 
+def test_no_signal_power_c_n0_or_eb_n0_at_the_noise_floor():
+    """D-76 (LS-1): at the noise floor (R - N < 3 dB) the signal is below the noise, so the E22's
+    signal power est. and the C/N0 and Eb/N0 built on it are not measurable (None, and absent
+    from /metrics); 3-10 dB above the noise they are the noise-removed estimates."""
+    r = _rx()                                                                       # E22-400T33D
+    r.tick(T0, 90.0)
+    r.on_noise(-118.0, T0)
+    for i, rssi in enumerate((-117.0, -116.0)):                                      # 1 and 2 dB above
+        r.on_reception(T0 + 1 + i, rssi)
+        rf = r.snapshot(T0 + 1 + i)["rf"]
+        assert rf["margin_state"] == "NOISE_FLOOR" and rf["snr_est_db"] == rssi + 118.0
+        assert (rf["pr_est_dbm"], rf["cn0_est_dbhz"], rf["ebn0_est_db"]) == (None, None, None)
+        text = web.prometheus({"rx": {"state": {"los": False}, "rf": rf}})
+        assert "dssq_rf_pr_est_dbm" not in text and "dssq_rf_cn0_est_dbhz" not in text
+        assert "dssq_rf_ebn0_est_db" not in text
+    r.on_reception(T0 + 3, -112.0)                                                  # 6 dB above: NEAR_NOISE
+    rf = r.snapshot(T0 + 3)["rf"]
+    pr = 10 * math.log10(10 ** -11.2 - 10 ** -11.8)
+    assert rf["margin_state"] == "NEAR_NOISE" and rf["pr_est_dbm"] == pytest.approx(pr)
+    n0 = -118.0 - 10 * math.log10(r.cfg_noise_bw_hz)
+    assert rf["cn0_est_dbhz"] == pytest.approx(pr - n0)
+    assert rf["ebn0_est_db"] == pytest.approx(pr - n0 - 10 * math.log10(2400))
+
+
 def test_overload_and_invalid_readings_stay_out_of_every_statistic():
     r = _rx()
     r.on_noise(-118.0, T0)
