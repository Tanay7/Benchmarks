+    """LS-2 (D-76): receptions are not decoded frames. 12 foreign SX126x packets at -95 dBm
+    (noise -120 dBm) and no frame decoded give no FER at all - never a FER of 0 % and a faster
+    rate; the dashboard sees the counts of the window."""
+    lm = LinkManager(target_margin_db=6.0, period_s=0, holdoff_s=0, model="SX126x", min_rate=0)
+    lm.mode = "AUTO"
+    rx = {"window_s": 600.0, "rssi": {"n": 12, "p10": -95.0}, "noise": {"n": 5, "mean": -120.0},
+          "frames": 0, "lost": 0, "fer": None}
+    assert lm.evaluate(1.0, rx, rate_code=1, power_code=0) is None
+    rec = lm.recommendation
+    assert rec["action"] == "NONE" and rec["why"] == "insufficient data (< 10 decoded frames in 600 s)"
+    assert (rec["frames"], rec["lost"], rec["fer"]) == (0, 0, None) and "margin_p10_db" not in rec
+    lm.evaluate(2.0, {**rx, "frames": 9, "lost": 0, "fer": 0.0}, rate_code=1, power_code=0)
+    assert lm.recommendation["why"] == "insufficient data (< 10 decoded frames in 600 s)"
+    rec = lm.evaluate(3.0, {**rx, "frames": 10, "lost": 0, "fer": 0.0}, rate_code=1, power_code=0)
+    assert rec is not None and rec["action"] == "LINKRATE" and rec["value"] == 2 and rec["fer"] == 0.0
